# Copy this file to .env and customize it for each deployment.
PORTAL_TITLE=Service Portal
# Host path to an SVG, PNG, ICO, GIF, JPEG, WebP, or AVIF favicon.
PORTAL_FAVICON_PATH=./star.svg
SERVICE_PORT=8080
# Numeric host UID:GID used by the detached updater when it writes to this checkout.
# Run `id -u` and `id -g` on the Docker host and combine them as UID:GID.
PORTAL_UPDATE_USER=1000:1000
# Minutes between update checks for opted-in projects (0 = only on page open
# and after project actions).
UPDATE_CHECK_INTERVAL_MINUTES=15
